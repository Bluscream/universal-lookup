# ============================================
# Universal Lookup — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# ---- Server ----
PORT=24010
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Auth ----
# If set, all /api/* lookup requests require this token
# via ?token=<value> or Authorization: Bearer <value>
REQUIRE_TOKEN=

# ---- Feature Flags ----
# Set to 'true' to disable ?raw and ?fresh query params
DISABLE_RAW=false
DISABLE_FRESH=false

# ---- Rate Limiting (our API) ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---- Cache ----
DB_PATH=./data/cache.db
CACHE_TTL=86400
CACHE_TTL_PARCEL=3600

# ---- Timeouts ----
PROVIDER_TIMEOUT=10000
PUPPETEER_TIMEOUT=15000

# ---- API Keys (all optional — falls back to free/scraping when not provided) ----
IP_API_COM_KEY=
IP_API_IO_KEY=
TELLOWS_API_KEY=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./data/maxmind
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
PARCELSAPP_API_KEY=
DHL_API_KEY=

# ---- FritzBox (optional) ----
FRITZBOX_HOST=fritz.box
FRITZBOX_USER=
FRITZBOX_PASS=
PHONE_COUNTRY_PREFIX=0049
PHONE_LOCAL_PREFIX=6131

# ---- Providers Selection & Ordering (Comma-separated list of provider names)
PROVIDERS_TEL=emergency,fritzbox,tellows,dastelefonbuch,11880,dasoertliche,google,bing,duckduckgo,yahoo
PROVIDERS_IP=ip-api.com,ip-api.io,ip-api.io/risk,maxmind,whois,dns,ping,traceroute,portscan,subdomain,google,bing,duckduckgo,yahoo
PROVIDERS_DOMAIN=whois,dns,subdomain,google,bing,duckduckgo,yahoo
PROVIDERS_EMAIL=dns,ip-api.io/email,ip-api.io/email-advanced,ip-api.io/risk,google,bing,duckduckgo,yahoo
PROVIDERS_LOCATION=nominatim,google-maps,google,bing,duckduckgo,yahoo
PROVIDERS_PARCEL=dhl-web,dhl,parcelsapp,google,bing,duckduckgo,yahoo

# Universal Search
UNIVERSAL_RESULTS_LIMIT=3

# ---- Puppeteer ----
PUPPETEER_SKIP_DOWNLOAD=true
# Docker/Unraid image: /usr/bin/chromium (leave empty to auto-detect on Linux)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
