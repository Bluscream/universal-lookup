# ============================================
# Universal Lookup — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# ---- Server ----
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Auth & Feature Flags ----
# If set, all /api/* lookup requests require this token
# via ?token=<value> or Authorization: Bearer <value>
REQUIRE_TOKEN=
DISABLE_RAW=false
DISABLE_FRESH=false
DISABLE_WAIT=false

# ---- Rate Limiting (our API) ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---- Cache ----
DB_PATH=./data/cache.db
CACHE_TTL=86400
CACHE_TTL_PARCEL=3600

# ---- Timeouts (in ms) ----
CLIENT_TIMEOUT=5000
SERVER_TIMEOUT=30000
PUPPETEER_TIMEOUT=10000

# ---- API Keys (all optional — falls back to free/scraping when not provided) ----
IP_API_COM_KEY=
IP_API_IO_KEY=
TELLOWS_API_KEY=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./data/maxmind
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
PARCELSAPP_API_KEY=
DHL_API_KEY=
STEAM_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
BACKPACK_TF_API_KEY=
SEVENTEEN_TRACK_API_KEY=
AMAZON_USERNAME=
AMAZON_PASSWORD=
AMAZON_TOTP_KEY=
AMAZON_COOKIES_FILE=
ALIEXPRESS_USERNAME=
ALIEXPRESS_PASSWORD=
ALIEXPRESS_COOKIES_FILE=
ALIEXPRESS_TOTP_KEY=
UPS_ACCESS_KEY=
USPS_USERNAME=
FEDEX_API_KEY=
FEDEX_SECRET_KEY=

# ---- FritzBox (optional) ----
FRITZBOX_HOST=fritz.box
FRITZBOX_USER=
FRITZBOX_PASS=
PHONE_COUNTRY_PREFIX=0049
PHONE_LOCAL_PREFIX=6131

# ---- Providers Selection & Ordering (Comma-separated list of provider names) ----
PROVIDERS_TEL=emergency,fritzbox,tellows,dastelefonbuch,11880,dasoertliche
PROVIDERS_IP=ip-api.com,ip-api.io,ip-api.io/risk,maxmind,whois,dns,ping,traceroute,portscan,subdomain
PROVIDERS_DOMAIN=whois,dns,subdomain
PROVIDERS_EMAIL=dns,ip-api.io/email,ip-api.io/email-advanced,ip-api.io/risk
PROVIDERS_LOCATION=nominatim,google-maps
PROVIDERS_PARCEL=dhl-web,dhl,amazon-tba,ups,usps,fedex,parcelsapp,pkge,17track
PROVIDERS_WEB=google,bing,duckduckgo,yahoo
PROVIDERS_STEAM=playerdb,steam-xml,steam-api,steam-inventory,backpack-tf,csfloat
PROVIDERS_URL=dns-lookup,ip-info,metadata,urlscan,virustotal
PROVIDERS_ORDER=amazon
# Service health / uptime status providers (combined into one response)
PROVIDERS_STATUS=discord,vrchat,cloudflare,github,epic,reddit,twitch,xbox,playstation,activision,steam
# The `steam` status provider uses the official Steam Web API
# (ICSGOServers_730/GetGameServersStatus) and requires STEAM_API_KEY to be set;
# it is skipped automatically if the key is missing.

# ---- Status providers ----
# CACHE_TTL_STATUS=120
# STATUS_USER_AGENT=Mozilla/5.0 (compatible; universal-lookup/1.0; +https://github.com/)
# PlayStation Network region: SCEA=Americas, SCEE=Europe, SCEJ=Asia
# STATUS_PSN_REGION=SCEA
# STATUS_PSN_COUNTRY=US

# ---- Universal Search ----
UNIVERSAL_RESULTS_LIMIT=3

# ---- Puppeteer ----
PUPPETEER_SKIP_DOWNLOAD=true
# Docker/Unraid image: /usr/bin/chromium (leave empty to auto-detect on Linux)
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_ARGS=--ignore-certificate-errors --ignore-certificate-errors-spki-list --ignore-ssl-errors --disable-web-security --disable-features=ExtensionManifestV2Unsupported,ExtensionManifestV2Disabled
