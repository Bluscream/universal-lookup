<?xml version="1.0"?>
<Container version="2">
  <Name>universal-lookup-tailscale</Name>
  <Repository>bluscream1/universal-lookup</Repository>
  <Registry>https://hub.docker.com/r/bluscream1/universal-lookup</Registry>
  <Network>bridge</Network>
  <Privileged>true</Privileged>
  <Support>https://github.com/Bluscream/universal-lookup/issues</Support>
  <Project>https://github.com/Bluscream/universal-lookup</Project>
  <Overview>Universal Lookup (Tailscale Edition) - Aggregated lookup service with built-in Tailscale support.&#xD;
&#xD;
[b]Note:[/b] This version runs in Privileged mode with Tailscale persistence enabled.</Overview>
  <Category>Tools: Network:Other</Category>
  <WebUI>http://[IP]:[PORT:24010]/</WebUI>
  <Icon>https://raw.githubusercontent.com/Bluscream/universal-lookup/main/src/frontend/favicon.png</Icon>
  <ExtraParams>--cap-add=NET_ADMIN --device=/dev/net/tun</ExtraParams>
  <PostArgs/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <Config Name="Web Port" Target="24010" Default="24010" Mode="tcp" Description="Port for the web interface and API" Type="Port" Display="always" Required="true" Mask="false">24010</Config>
  <Config Name="Data Path" Target="/app/data" Default="/mnt/user/appdata/universal-lookup" Mode="rw" Description="Persistent data (cache DB, MaxMind databases)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/universal-lookup</Config>
  <Config Name="Tailscale State Path" Target="/var/lib/tailscale" Default="/mnt/user/appdata/universal-lookup/tailscale" Mode="rw" Description="Persistent state for Tailscale" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/universal-lookup/tailscale</Config>
  <Config Name="Log Level" Target="LOG_LEVEL" Default="info" Mode="" Description="Logging level (error, warn, info, debug)" Type="Variable" Display="always" Required="false" Mask="false">info</Config>
  <Config Name="Cache TTL (seconds)" Target="CACHE_TTL" Default="86400" Mode="" Description="How long to cache lookup results (default: 24 hours)" Type="Variable" Display="always" Required="false" Mask="false">86400</Config>
  <Config Name="Provider Timeout (ms)" Target="PROVIDER_TIMEOUT" Default="10000" Mode="" Description="Timeout for each provider in milliseconds" Type="Variable" Display="always" Required="false" Mask="false">10000</Config>
  <Config Name="Auth Token" Target="REQUIRE_TOKEN" Default="" Mode="" Description="If set, require this token for API access" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Rate Limit Max" Target="RATE_LIMIT_MAX" Default="100" Mode="" Description="Max requests per time window" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="ip-api.com Key" Target="IP_API_COM_KEY" Default="" Mode="" Description="API key for ip-api.com (optional, enables HTTPS + unlimited)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="ip-api.io Key" Target="IP_API_IO_KEY" Default="" Mode="" Description="API key for ip-api.io advanced features" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Tellows API Key" Target="TELLOWS_API_KEY" Default="" Mode="" Description="Tellows partner API key (optional, falls back to scraping)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="MaxMind License Key" Target="MAXMIND_LICENSE_KEY" Default="" Mode="" Description="MaxMind GeoLite2 license key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Google API Key" Target="GOOGLE_API_KEY" Default="" Mode="" Description="Google Maps & Search API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Google Search CX" Target="GOOGLE_SEARCH_CX" Default="" Mode="" Description="Google Custom Search Engine ID (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="ParcelsApp API Key" Target="PARCELSAPP_API_KEY" Default="" Mode="" Description="ParcelsApp tracking API key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="FritzBox Host" Target="FRITZBOX_HOST" Default="fritz.box" Mode="" Description="FritzBox hostname/IP" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="FritzBox User" Target="FRITZBOX_USER" Default="" Mode="" Description="FritzBox username" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="FritzBox Password" Target="FRITZBOX_PASS" Default="" Mode="" Description="FritzBox password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Phone Country Prefix" Target="PHONE_COUNTRY_PREFIX" Default="0049" Mode="" Description="Country prefix for phone numbers" Type="Variable" Display="always" Required="false" Mask="false">0049</Config>
  <Config Name="Phone Local Prefix" Target="PHONE_LOCAL_PREFIX" Default="6131" Mode="" Description="Local prefix for phone numbers" Type="Variable" Display="always" Required="false" Mask="false">6131</Config>
  <Config Name="Universal Results Limit" Target="UNIVERSAL_RESULTS_LIMIT" Default="3" Mode="" Description="Max results per provider" Type="Variable" Display="always" Required="false" Mask="false">3</Config>
  <Config Name="Providers Domain" Target="PROVIDERS_DOMAIN" Default="whois,dns,subdomain,google,bing,duckduckgo,yahoo" Mode="" Description="Domain lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">whois,dns,subdomain,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Host" Target="HOST" Default="0.0.0.0" Mode="" Description="Binding address" Type="Variable" Display="advanced" Required="false" Mask="false">0.0.0.0</Config>
  <Config Name="Disable Raw" Target="DISABLE_RAW" Default="false" Mode="" Description="Set to true to disable ?raw query param" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Disable Fresh" Target="DISABLE_FRESH" Default="false" Mode="" Description="Set to true to disable ?fresh query param" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Rate Limit Window" Target="RATE_LIMIT_WINDOW" Default="1 minute" Mode="" Description="Rate limit time window" Type="Variable" Display="advanced" Required="false" Mask="false">1 minute</Config>
  <Config Name="Cache TTL Parcel (seconds)" Target="CACHE_TTL_PARCEL" Default="3600" Mode="" Description="Cache duration for parcels" Type="Variable" Display="advanced" Required="false" Mask="false">3600</Config>
  <Config Name="Puppeteer Timeout (ms)" Target="PUPPETEER_TIMEOUT" Default="15000" Mode="" Description="Max wait time for headless browser" Type="Variable" Display="advanced" Required="false" Mask="false">15000</Config>
  <Config Name="DHL API Key" Target="DHL_API_KEY" Default="" Mode="" Description="Key for official DHL API" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Providers Telephone" Target="PROVIDERS_TEL" Default="emergency,fritzbox,tellows,dastelefonbuch,11880,dasoertliche,google,bing,duckduckgo,yahoo" Mode="" Description="Telephone lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">emergency,fritzbox,tellows,dastelefonbuch,11880,dasoertliche,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers IP" Target="PROVIDERS_IP" Default="ip-api.com,ip-api.io,ip-api.io/risk,maxmind,whois,dns,ping,traceroute,portscan,subdomain,google,bing,duckduckgo,yahoo" Mode="" Description="IP lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">ip-api.com,ip-api.io,ip-api.io/risk,maxmind,whois,dns,ping,traceroute,portscan,subdomain,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Email" Target="PROVIDERS_EMAIL" Default="dns,ip-api.io/email,ip-api.io/email-advanced,ip-api.io/risk,google,bing,duckduckgo,yahoo" Mode="" Description="Email lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">dns,ip-api.io/email,ip-api.io/email-advanced,ip-api.io/risk,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Location" Target="PROVIDERS_LOCATION" Default="nominatim,google-maps,google,bing,duckduckgo,yahoo" Mode="" Description="Location lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">nominatim,google-maps,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Parcel" Target="PROVIDERS_PARCEL" Default="dhl-web,dhl,parcelsapp,google,bing,duckduckgo,yahoo" Mode="" Description="Parcel tracking providers" Type="Variable" Display="advanced" Required="false" Mask="false">dhl-web,dhl,parcelsapp,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Puppeteer Skip Download" Target="PUPPETEER_SKIP_DOWNLOAD" Default="false" Mode="" Description="Skip downloading Chromium" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Puppeteer Executable Path" Target="PUPPETEER_EXECUTABLE_PATH" Default="" Mode="" Description="Path to custom Chromium executable" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
