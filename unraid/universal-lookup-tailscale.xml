<?xml version="1.0"?>
<Container version="2">
  <Name>universal-lookup-tailscale</Name>
  <Repository>bluscream1/universal-lookup</Repository>
  <Registry>https://hub.docker.com/r/bluscream1/universal-lookup</Registry>
  <Network>bridge</Network>
  <Privileged>true</Privileged>
  <Support>https://github.com/Bluscream/universal-lookup/issues</Support>
  <Project>https://github.com/Bluscream/universal-lookup</Project>
  <Overview>Universal Lookup (Tailscale Edition) - Aggregated lookup service with built-in Tailscale support.&#xD;
&#xD;
[b]Note:[/b] This version runs in Privileged mode with Tailscale persistence enabled.</Overview>
  <Category>Tools: Network:Other</Category>
  <WebUI>http://[IP]:[PORT:24010]/</WebUI>
  <Icon>https://raw.githubusercontent.com/Bluscream/universal-lookup/main/src/frontend/favicon.png</Icon>
  <ExtraParams>--cap-add=NET_ADMIN --device=/dev/net/tun</ExtraParams>
  <PostArgs/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <!-- Ports & Paths -->
  <Config Name="Web Port" Target="24010" Default="24010" Mode="tcp" Description="Port for the web interface (Vite)" Type="Port" Display="always" Required="true" Mask="false">24010</Config>
  <Config Name="API Port" Target="24011" Default="24011" Mode="tcp" Description="Port for the Fastify API backend" Type="Port" Display="always" Required="true" Mask="false">24011</Config>
  <Config Name="Data Path" Target="/app/backend/data" Default="/mnt/user/appdata/universal-lookup" Mode="rw" Description="Persistent data (cache DB, MaxMind databases)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/universal-lookup</Config>
  <Config Name="Tailscale State Path" Target="/var/lib/tailscale" Default="/mnt/user/appdata/universal-lookup/tailscale" Mode="rw" Description="Persistent state for Tailscale" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/universal-lookup/tailscale</Config>

  <!-- Environment variables (alphabetical) -->
  <Config Name="17track API Key" Target="SEVENTEEN_TRACK_API_KEY" Default="" Mode="" Description="17track.net API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="AliExpress Cookies File" Target="ALIEXPRESS_COOKIES_FILE" Default="/app/backend/data/aliexpress-cookies.json" Mode="" Description="Path to AliExpress cookies JSON file" Type="Variable" Display="advanced" Required="false" Mask="false">/app/backend/data/aliexpress-cookies.json</Config>
  <Config Name="AliExpress Password" Target="ALIEXPRESS_PASSWORD" Default="" Mode="" Description="AliExpress password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="AliExpress TOTP Key" Target="ALIEXPRESS_TOTP_KEY" Default="" Mode="" Description="AliExpress 2FA TOTP secret key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="AliExpress Username" Target="ALIEXPRESS_USERNAME" Default="" Mode="" Description="AliExpress username (email)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Amazon Cookies File" Target="AMAZON_COOKIES_FILE" Default="/app/backend/data/amazon-cookies.json" Mode="" Description="Path to Amazon cookies JSON file" Type="Variable" Display="advanced" Required="false" Mask="false">/app/backend/data/amazon-cookies.json</Config>
  <Config Name="Amazon Password" Target="AMAZON_PASSWORD" Default="" Mode="" Description="Amazon password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Amazon TOTP Key" Target="AMAZON_TOTP_KEY" Default="" Mode="" Description="Amazon 2FA TOTP secret key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Amazon Username" Target="AMAZON_USERNAME" Default="" Mode="" Description="Amazon username (email)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Auth Token" Target="REQUIRE_TOKEN" Default="" Mode="" Description="If set, require this token for API access" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Backpack.tf API Key" Target="BACKPACK_TF_API_KEY" Default="" Mode="" Description="backpack.tf API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Cache TTL (seconds)" Target="CACHE_TTL" Default="86400" Mode="" Description="How long to cache lookup results (default: 24 hours)" Type="Variable" Display="always" Required="false" Mask="false">86400</Config>
  <Config Name="Cache TTL Parcel (seconds)" Target="CACHE_TTL_PARCEL" Default="3600" Mode="" Description="Cache duration for parcels" Type="Variable" Display="advanced" Required="false" Mask="false">3600</Config>
  <Config Name="Cache TTL Status (s)" Target="CACHE_TTL_STATUS" Default="120" Mode="" Description="Cache duration for status lookups (seconds)" Type="Variable" Display="advanced" Required="false" Mask="false">120</Config>
  <Config Name="Client Timeout (ms)" Target="CLIENT_TIMEOUT" Default="5000" Mode="" Description="Max time to wait for initial API response" Type="Variable" Display="advanced" Required="false" Mask="false">5000</Config>
  <Config Name="DHL API Key" Target="DHL_API_KEY" Default="" Mode="" Description="Key for official DHL API" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Disable Fresh" Target="DISABLE_FRESH" Default="false" Mode="" Description="Set to true to disable ?fresh query param" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Disable Raw" Target="DISABLE_RAW" Default="false" Mode="" Description="Set to true to disable ?raw query param" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Disable Wait" Target="DISABLE_WAIT" Default="false" Mode="" Description="Set to true to disable ?wait query param" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="FedEx API Key" Target="FEDEX_API_KEY" Default="" Mode="" Description="FedEx Client ID / API Key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="FedEx Secret Key" Target="FEDEX_SECRET_KEY" Default="" Mode="" Description="FedEx Client Secret" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="FritzBox Host" Target="FRITZBOX_HOST" Default="fritz.box" Mode="" Description="FritzBox hostname/IP" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="FritzBox Password" Target="FRITZBOX_PASS" Default="" Mode="" Description="FritzBox password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="FritzBox User" Target="FRITZBOX_USER" Default="" Mode="" Description="FritzBox username" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Google API Key" Target="GOOGLE_API_KEY" Default="" Mode="" Description="Google Maps &amp; Search API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Google Search CX" Target="GOOGLE_SEARCH_CX" Default="" Mode="" Description="Google Custom Search Engine ID (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Host" Target="HOST" Default="0.0.0.0" Mode="" Description="Binding address" Type="Variable" Display="advanced" Required="false" Mask="false">0.0.0.0</Config>
  <Config Name="ip-api.com Key" Target="IP_API_COM_KEY" Default="" Mode="" Description="API key for ip-api.com (optional, enables HTTPS + unlimited)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="ip-api.io Key" Target="IP_API_IO_KEY" Default="" Mode="" Description="API key for ip-api.io advanced features" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Log Level" Target="LOG_LEVEL" Default="info" Mode="" Description="Logging level (error, warn, info, debug)" Type="Variable" Display="always" Required="false" Mask="false">info</Config>
  <Config Name="MaxMind License Key" Target="MAXMIND_LICENSE_KEY" Default="" Mode="" Description="MaxMind GeoLite2 license key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="ParcelsApp API Key" Target="PARCELSAPP_API_KEY" Default="" Mode="" Description="ParcelsApp tracking API key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Phone Country Prefix" Target="PHONE_COUNTRY_PREFIX" Default="0049" Mode="" Description="Country prefix for phone numbers" Type="Variable" Display="always" Required="false" Mask="false">0049</Config>
  <Config Name="Phone Local Prefix" Target="PHONE_LOCAL_PREFIX" Default="6131" Mode="" Description="Local prefix for phone numbers" Type="Variable" Display="always" Required="false" Mask="false">6131</Config>
  <Config Name="Providers APK" Target="PROVIDERS_APK" Default="googleplay,aptoide,apkpure,apkmirror,evozi,apkcombo,apkpremier,apkdl,apksupport" Mode="" Description="APK lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">googleplay,aptoide,apkpure,apkmirror,evozi,apkcombo,apkpremier,apkdl,apksupport</Config>
  <Config Name="Providers Domain" Target="PROVIDERS_DOMAIN" Default="whois,dns,subdomain,google,bing,duckduckgo,yahoo" Mode="" Description="Domain lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">whois,dns,subdomain,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Email" Target="PROVIDERS_EMAIL" Default="dns-email,ip-api.io/email,ip-api.io/email-advanced,ip-api.io/email-risk,google,bing,duckduckgo,yahoo" Mode="" Description="Email lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">dns-email,ip-api.io/email,ip-api.io/email-advanced,ip-api.io/email-risk,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers IP" Target="PROVIDERS_IP" Default="ip-api.com,ip-api.io,ip-api.io/risk,maxmind,whois,dns,ping,traceroute,portscan,subdomain,google,bing,duckduckgo,yahoo" Mode="" Description="IP lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">ip-api.com,ip-api.io,ip-api.io/risk,maxmind,whois,dns,ping,traceroute,portscan,subdomain,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Location" Target="PROVIDERS_LOCATION" Default="nominatim,google-maps,google,bing,duckduckgo,yahoo" Mode="" Description="Location lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">nominatim,google-maps,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Order" Target="PROVIDERS_ORDER" Default="amazon,aliexpress" Mode="" Description="Order lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">amazon,aliexpress</Config>
  <Config Name="Providers Parcel" Target="PROVIDERS_PARCEL" Default="dhl-web,dhl,amazon-tba,ups,usps,fedex,parcelsapp,pkge,17track,google,bing,duckduckgo,yahoo" Mode="" Description="Parcel tracking providers" Type="Variable" Display="advanced" Required="false" Mask="false">dhl-web,dhl,amazon-tba,ups,usps,fedex,parcelsapp,pkge,17track,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Shipment" Target="PROVIDERS_SHIPMENT" Default="amazon,google,bing,duckduckgo,yahoo" Mode="" Description="Shipment lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">amazon,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers Status" Target="PROVIDERS_STATUS" Default="discord,vrchat,cloudflare,github,epic,reddit,twitch,xbox,playstation,activision,steam,ea,ubisoft,battlenet,nintendo,vercel,digitalocean,netlify,gcp,aws,azure" Mode="" Description="Service-status providers to query" Type="Variable" Display="advanced" Required="false" Mask="false">discord,vrchat,cloudflare,github,epic,reddit,twitch,xbox,playstation,activision,steam,ea,ubisoft,battlenet,nintendo,vercel,digitalocean,netlify,gcp,aws,azure</Config>
  <Config Name="Providers Steam" Target="PROVIDERS_STEAM" Default="playerdb,steam-xml,steam-api,steam-inventory,backpack-tf,csfloat,steam-db" Mode="" Description="Steam lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">playerdb,steam-xml,steam-api,steam-inventory,backpack-tf,csfloat,steam-db</Config>
  <Config Name="Providers Telephone" Target="PROVIDERS_TEL" Default="emergency,fritzbox,tellows,dastelefonbuch,11880,dasoertliche,google,bing,duckduckgo,yahoo" Mode="" Description="Telephone lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">emergency,fritzbox,tellows,dastelefonbuch,11880,dasoertliche,google,bing,duckduckgo,yahoo</Config>
  <Config Name="Providers URL" Target="PROVIDERS_URL" Default="dns-lookup,ip-info,metadata,urlscan,virustotal" Mode="" Description="URL lookup providers" Type="Variable" Display="advanced" Required="false" Mask="false">dns-lookup,ip-info,metadata,urlscan,virustotal</Config>
  <Config Name="Providers Web" Target="PROVIDERS_WEB" Default="google,bing,duckduckgo,yahoo" Mode="" Description="Web search providers" Type="Variable" Display="advanced" Required="false" Mask="false">google,bing,duckduckgo,yahoo</Config>
  <Config Name="Puppeteer Args" Target="PUPPETEER_ARGS" Default="" Mode="" Description="Extra Chromium launch arguments" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Puppeteer Executable Path" Target="PUPPETEER_EXECUTABLE_PATH" Default="/usr/bin/chromium" Mode="" Description="Path to Chromium (Docker/Unraid: /usr/bin/chromium)" Type="Variable" Display="advanced" Required="false" Mask="false">/usr/bin/chromium</Config>
  <Config Name="Puppeteer Skip Download" Target="PUPPETEER_SKIP_DOWNLOAD" Default="true" Mode="" Description="Skip downloading Chromium (use system binary in Docker)" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Puppeteer Timeout (ms)" Target="PUPPETEER_TIMEOUT" Default="10000" Mode="" Description="Max wait time for headless browser" Type="Variable" Display="advanced" Required="false" Mask="false">10000</Config>
  <Config Name="Rate Limit Max" Target="RATE_LIMIT_MAX" Default="100" Mode="" Description="Max requests per time window" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="Rate Limit Window" Target="RATE_LIMIT_WINDOW" Default="1 minute" Mode="" Description="Rate limit time window" Type="Variable" Display="advanced" Required="false" Mask="false">1 minute</Config>
  <Config Name="Server Timeout (ms)" Target="SERVER_TIMEOUT" Default="30000" Mode="" Description="Max time for background processing to update cache" Type="Variable" Display="advanced" Required="false" Mask="false">30000</Config>
  <Config Name="Status Ignored Issues" Target="STATUS_IGNORED" Default="Crash Team Racing Nitro-Fueled — Xbox One;Crash Team Racing Nitro-Fueled — PlayStation 4;Crash Team Racing Nitro-Fueled — Nintendo Switch;Skylanders SuperChargers — Xbox 360;Workers AI experiencing degraded availability in some models" Mode="" Description="Semicolon-separated incident names to ignore (substring match); a service with all incidents ignored is reported operational" Type="Variable" Display="advanced" Required="false" Mask="false">Crash Team Racing Nitro-Fueled — Xbox One;Crash Team Racing Nitro-Fueled — PlayStation 4;Crash Team Racing Nitro-Fueled — Nintendo Switch;Skylanders SuperChargers — Xbox 360;Workers AI experiencing degraded availability in some models</Config>
  <Config Name="Status User-Agent" Target="STATUS_USER_AGENT" Default="Mozilla/5.0 (compatible; universal-lookup/1.0; +https://github.com/)" Mode="" Description="User-Agent header for status requests" Type="Variable" Display="advanced" Required="false" Mask="false">Mozilla/5.0 (compatible; universal-lookup/1.0; +https://github.com/)</Config>
  <Config Name="Status: Blizzard Client Id" Target="BLIZZARD_CLIENT_ID" Default="" Mode="" Description="Blizzard API client id (optional; enables detailed WoW realm status)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Status: Blizzard Client Secret" Target="BLIZZARD_CLIENT_SECRET" Default="" Mode="" Description="Blizzard API client secret (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Status: Blizzard Realm Sample" Target="STATUS_BLIZZARD_REALM_SAMPLE" Default="3" Mode="" Description="Number of WoW connected-realms to sample" Type="Variable" Display="advanced" Required="false" Mask="false">3</Config>
  <Config Name="Status: Blizzard Region" Target="STATUS_BLIZZARD_REGION" Default="us" Mode="" Description="Blizzard region (us, eu, kr, tw)" Type="Variable" Display="advanced" Required="false" Mask="false">us</Config>
  <Config Name="Status: Blizzard Slow (ms)" Target="STATUS_BLIZZARD_SLOW_MS" Default="2500" Mode="" Description="Latency threshold for degraded in no-auth approximate mode" Type="Variable" Display="advanced" Required="false" Mask="false">2500</Config>
  <Config Name="Status: Nintendo Locale" Target="STATUS_NINTENDO_LOCALE" Default="en_US" Mode="" Description="Nintendo netinfo locale (en_US, en_GB, ja_JP)" Type="Variable" Display="advanced" Required="false" Mask="false">en_US</Config>
  <Config Name="Status: PSN Country" Target="STATUS_PSN_COUNTRY" Default="US" Mode="" Description="PlayStation country code" Type="Variable" Display="advanced" Required="false" Mask="false">US</Config>
  <Config Name="Status: PSN Region" Target="STATUS_PSN_REGION" Default="SCEA" Mode="" Description="PlayStation region (SCEA=Americas, SCEE=Europe, SCEJ=Asia)" Type="Variable" Display="advanced" Required="false" Mask="false">SCEA</Config>
  <Config Name="Status: Ubisoft App-Id" Target="STATUS_UBISOFT_APP_ID" Default="f612511e-58a2-4e9a-831f-61838b1950bb" Mode="" Description="Ubisoft public Ubi-AppId header" Type="Variable" Display="advanced" Required="false" Mask="false">f612511e-58a2-4e9a-831f-61838b1950bb</Config>
  <Config Name="Status: Ubisoft App-Ids" Target="STATUS_UBISOFT_APP_IDS" Default="e3d5ea9e-50bd-43b7-88bf-39794f4e3d40,fb4cc4c9-2063-461d-a1e8-84a7d36525fc,6e3c99c9-6c3f-43f4-b4f6-f1a3143f2764,76f580d5-7f50-47cc-bbc1-152d000bfe59,4008612d-3baf-49e4-957a-33066726a7bc" Mode="" Description="Ubisoft application GUIDs to check (add launcher/games)" Type="Variable" Display="advanced" Required="false" Mask="false">e3d5ea9e-50bd-43b7-88bf-39794f4e3d40,fb4cc4c9-2063-461d-a1e8-84a7d36525fc,6e3c99c9-6c3f-43f4-b4f6-f1a3143f2764,76f580d5-7f50-47cc-bbc1-152d000bfe59,4008612d-3baf-49e4-957a-33066726a7bc</Config>
  <Config Name="Steam API Key" Target="STEAM_API_KEY" Default="" Mode="" Description="Steam Web API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Tellows API Key" Target="TELLOWS_API_KEY" Default="" Mode="" Description="Tellows partner API key (optional, falls back to scraping)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Universal Results Limit" Target="UNIVERSAL_RESULTS_LIMIT" Default="3" Mode="" Description="Max results per provider" Type="Variable" Display="always" Required="false" Mask="false">3</Config>
  <Config Name="UPS Access Key" Target="UPS_ACCESS_KEY" Default="" Mode="" Description="UPS Access License Number" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="URLScan API Key" Target="URLSCAN_API_KEY" Default="" Mode="" Description="urlscan.io API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="USPS Username" Target="USPS_USERNAME" Default="" Mode="" Description="USPS WebTools API Username" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="VirusTotal API Key" Target="VIRUSTOTAL_API_KEY" Default="" Mode="" Description="VirusTotal API key (optional)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
</Container>
