# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment (contains secrets)
.env
unraid/*.nas
# scripts/update.ps1 writes an npm auth token here; its cleanup does not
# survive a Ctrl-C, and the release script stages everything.
.npmrc

# Data (runtime caches, databases, MaxMind DBs)
data/

# References (HAR captures, pcaps — large + potentially sensitive)
.references/
scratch/

# Agent/IDE working files
.agent/
.gemini/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Puppeteer cache
.cache/puppeteer/
.playwright-mcp/
*_test.json
tracking_page.html
.scratch/
.references/
