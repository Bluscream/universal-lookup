{
  "name": "universal-lookup",
  "version": "1.1.0",
  "description": "Universal lookup service aggregating multiple APIs for phone, IP, email, location, and parcel lookups with smart caching and response merging",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "lookup",
    "ip",
    "email",
    "phone",
    "geolocation",
    "whois",
    "dns",
    "parcel",
    "tracking"
  ],
  "author": "Bluscream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bluscream/universal-lookup.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@maxmind/geoip2-node": "^5.0.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^11.8.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "ping": "^0.4.4",
    "puppeteer": "^24.8.2",
    "sql.js": "^1.14.1",
    "whois": "^2.14.2",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
