{
  "name": "universal-lookup",
  "version": "1.3.0",
  "description": "Universal lookup service aggregating multiple APIs for phone, IP, email, location, and parcel lookups with smart caching and response merging",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format --write src/"
  },
  "keywords": [
    "lookup",
    "ip",
    "email",
    "phone",
    "geolocation",
    "whois",
    "dns",
    "parcel",
    "tracking"
  ],
  "author": "Bluscream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bluscream/universal-lookup.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@maxmind/geoip2-node": "^6.3.4",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ping": "^1.0.0",
    "puppeteer": "^24.43.0",
    "sql.js": "^1.14.1",
    "whois": "^2.16.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
